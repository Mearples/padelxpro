# Supabase data export — copy this file to ".env" and fill in ONE mode.
# The real .env file is git-ignored; never commit your keys.

# ── Mode A (recommended) — direct Postgres, exports EVERY table ────────────
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
# Use the connection string and insert your database password.
# SUPABASE_DB_URL="postgresql://postgres:YOUR-DB-PASSWORD@db.sxxvagbiqdisysvbonzw.supabase.co:5432/postgres"

# ── Mode B — REST / service role, no DB password (you list the tables) ─────
# SUPABASE_URL="https://sxxvagbiqdisysvbonzw.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service_role-key"
# SUPABASE_TABLES="players,matches,bookings"
